#==========================================
# Copy this file to .env and change values
#==========================================

# ========== Elasticsearch ==========
STACK_VERSION=8.19.7
ELASTIC_PASSWORD=<change-me>
ES_PORT=9200
ES_CPU_LIMIT=2.0

# ========== Kibana ==========
KIBANA_PASSWORD=<change-me>
KIBANA_PORT=5601
KIBANA_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
KIBANA_SAVED_OBJECTS_KEY=<generate-with-openssl-rand-hex-32>
KIBANA_REPORTING_KEY=<generate-with-openssl-rand-hex-32>
KIBANA_CPU_LIMIT=1.0

# ========== Filebeat (collector) ==========
LOGS_DIR=../SIEMgen/logs

# Cluster settings
CLUSTER_NAME=siem-cluster
LICENSE=basic

# Memory limits (2GB per service)
MEM_LIMIT=2147483648

